# Copy this file to ".env" (same folder) and fill in your values. NEVER commit .env or share your API key.

# --- AI model: FREE option (pick ONE provider) ---------------------------------------------------
# groq       -> free key, no card: https://console.groq.com/keys
# gemini     -> free key: https://aistudio.google.com/apikey
# openrouter -> free key: https://openrouter.ai/keys   (use a model ending in :free)
# ollama     -> runs on your own PC, no key at all: https://ollama.com
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional: leave empty to use the default model. Model names change - check the provider's website if you get an error.
LLM_MODEL=

# --- AI model: Anthropic (paid). Only used when LLM_PROVIDER is empty or "anthropic" ------------------
# Create a key at https://console.anthropic.com  (needs an Anthropic account with billing/credit)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Your business ------------------------------------------------------------------------------
STORE_NAME=ORELLE
BUSINESS_ID=orelle-main
BUSINESS_TIMEZONE=Asia/Karachi
CURRENCY=PKR

# --- Databases ----------------------------------------------------------------------------------
# Leave both empty for local development:
#   STORE_DB_URL -> uses ../backend/db.sqlite3 (your Django shop database, opened READ-ONLY)
#   AGENT_DB_URL -> creates ai_service/assistant.sqlite3 (the assistant's own tables)
# For PostgreSQL later, e.g. postgresql+psycopg://user:pass@localhost/shop  (pip install "psycopg[binary]")
# and use a database user that only has SELECT permission for STORE_DB_URL.
STORE_DB_URL=
AGENT_DB_URL=

# --- Web / limits -------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOW_STOCK_THRESHOLD=5
RATE_LIMIT_PER_MINUTE=20
